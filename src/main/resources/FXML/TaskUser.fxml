<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:controller="com.softgenix.Controller.UserController" prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: #f5f7fa;" stylesheets="@/Styles/Dashboard.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>

        <HBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="header-bar"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="headerTitleLabel" styleClass="header-title" text="Mi tablero de Zendo" />
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10h1v-2h-1c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8v1.5c0 .83-.67 1.5-1.5 1.5h-3c-.83 0-1.5-.67-1.5-1.5V12h-2v1.5c0 1.93 1.57 3.5 3.5 3.5h3c1.93 0 3.5-1.57 3.5-3.5V12c0-5.52-4.48-10-10-10z" styleClass="header-icon" />
                        <SVGPath content="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" styleClass="header-icon" />
                        <SVGPath content="M7 10l5 5 5-5z" styleClass="header-icon" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" styleClass="logout-button" text="Cerrar sesión" onAction="#cerrarSesion" />
                        <StackPane prefHeight="50.0" prefWidth="50.0">
                            <children>
                                <Circle radius="25.0"
                                        style="-fx-fill: linear-gradient(to bottom right, #ffd700, #ffb347); -fx-stroke: white; -fx-stroke-width: 3; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 2);" />
                                <Text fx:id="userInitialsText"
                                      style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2c3e50;"
                                      text="U" />
                            </children>
                        </StackPane>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
        </HBox>


        <HBox spacing="30.0" alignment="CENTER"
              AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="110.0">
            <children>
                <!-- Columna En Proceso con ScrollPane -->
                <VBox spacing="20.0" alignment="TOP_CENTER"
                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 12, 0, 0, 4); -fx-border-color: #e3f2fd; -fx-border-width: 2; -fx-border-radius: 20;"
                      HBox.hgrow="ALWAYS">
                    <children>
                        <!-- Header de columna mejorado -->
                        <HBox alignment="CENTER" spacing="10.0"
                              style="-fx-background-color: linear-gradient(to right, #42a5f5, #1e88e5); -fx-background-radius: 15 15 0 0; -fx-padding: 15 20;">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"
                                       text="⚡ En Proceso" />
                            </children>
                        </HBox>

                        <!-- ScrollPane para tarjetas -->
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                    style="-fx-background: transparent; -fx-background-color: transparent;">
                            <content>
                                <VBox fx:id="enProcesoColumn" spacing="15.0" alignment="TOP_CENTER"
                                      style="-fx-background-color: transparent;">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <!-- Separador visual mejorado -->
                <VBox alignment="CENTER" prefWidth="4.0">
                    <children>
                        <Separator orientation="VERTICAL" prefHeight="200.0"
                                   style="-fx-background-color: linear-gradient(to bottom, transparent, #e0e0e0, transparent);" />
                    </children>
                </VBox>

                <!-- Columna Completadas con ScrollPane -->
                <VBox spacing="20.0" alignment="TOP_CENTER"
                      style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 12, 0, 0, 4); -fx-border-color: #e8f5e8; -fx-border-width: 2; -fx-border-radius: 20;"
                      HBox.hgrow="ALWAYS">
                    <children>
                        <!-- Header de columna mejorado -->
                        <HBox alignment="CENTER" spacing="10.0"
                              style="-fx-background-color: linear-gradient(to right, #66bb6a, #43a047); -fx-background-radius: 15 15 0 0; -fx-padding: 15 20;">
                            <children>
                                <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"
                                       text="✅ Completadas" />
                            </children>
                        </HBox>

                        <!-- ScrollPane para tarjetas -->
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                    style="-fx-background: transparent; -fx-background-color: transparent;">
                            <content>
                                <VBox fx:id="completadaColumn" spacing="15.0" alignment="TOP_CENTER"
                                      style="-fx-background-color: transparent;">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Indicador de carga (opcional) -->
        <StackPane fx:id="loadingIndicator" visible="false"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="80.0"
                   style="-fx-background-color: rgba(255,255,255,0.8);">
            <children>
                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #666;" text="⏳ Cargando tareas..." />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #999;" text="Por favor espera un momento" />
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>