<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.softgenix.Controller.CAlerta"
            styleClass="alert-root"
            prefWidth="400" prefHeight="200">
    <children>
        <VBox fx:id="alertBox" alignment="CENTER" spacing="20.0"
              AnchorPane.topAnchor="20.0" AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
              styleClass="alert-box">
            <Label fx:id="lblMensaje" wrapText="true" text="Mensaje de ejemplo" styleClass="alert-message"/>
            <Button text="Aceptar" onAction="#cerrarAlerta" styleClass="alert-button"/>
        </VBox>
    </children>
</AnchorPane>




