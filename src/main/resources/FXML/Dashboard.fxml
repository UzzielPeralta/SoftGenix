<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.softgenix.Controller.SuperAdminController">
    <children>
        <VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="280.0" spacing="20.0" styleClass="left-pane" stylesheets="@/Styles/Dashboard.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="12.0">
                    <children>
                        <ImageView fitHeight="52.0" fitWidth="66.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/Zendo_loto.png" />
                            </image>
                        </ImageView>
                        <Label styleClass="logo-text" text="Zendo" />
                    </children>
                </HBox>
                <Button fx:id="crearTableroBtn" mnemonicParsing="false" onAction="#mostrarGestionTableros" prefHeight="45.0" prefWidth="240.0" styleClass="sidebar-button" text="+ Crear tablero" />
                <Button fx:id="crearAdminBtn" mnemonicParsing="false" onAction="#mostrarGestionUsuarios" prefHeight="45.0" prefWidth="240.0" styleClass="sidebar-button" text="+ Crear Admin" />
            </children>
            <padding>
                <Insets left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
        <AnchorPane layoutX="280.0" prefHeight="720.0" prefWidth="1000.0" style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="280.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="1000.0" styleClass="header-bar" stylesheets="@/Styles/Dashboard.css" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <Label fx:id="headerTitleLabel" styleClass="header-title" text="Inicio Zendo" />
                        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                            <children>
                                <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="logout-button" text="Cerrar sesión" />
                                <StackPane prefHeight="40.0" prefWidth="40.0">
                                    <children>
                                        <Circle radius="20.0" styleClass="user-circle" />
                                        <Text styleClass="user-initials" text="JR" />
                                    </children>
                                    <HBox.margin>
                                        <Insets left="20.0" />
                                    </HBox.margin>
                                </StackPane>
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </HBox>

                <!-- Panel de bienvenida que se muestra al inicio -->
                <VBox fx:id="welcomePanel" alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
                    <children>
                        <ImageView fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/Zendo_loto.png" />
                            </image>
                        </ImageView>
                        <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="Bienvenido a Zendo" />
                        <Label style="-fx-font-size: 16;" text="Selecciona una opción del menú lateral para comenzar" />
                    </children>
                </VBox>


                <!-- Panel de gestión de usuarios - inicialmente oculto -->
                <AnchorPane fx:id="usuariosPanel" stylesheets="@/Styles/Dashboard.css" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
                    <children>
                        <SplitPane dividerPositions="0.4" prefHeight="650.0" prefWidth="1000.0" styleClass="split-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <items>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                                    <children>
                                        <VBox spacing="15.0" styleClass="form-container" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                            <children>
                                                <Label styleClass="form-title" text="Crear nuevo admin" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label prefWidth="80.0" text="Nombre:" />
                                                        <TextField fx:id="nombreField" styleClass="form-field" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label prefWidth="80.0" text="Email:" />
                                                        <TextField fx:id="emailField" styleClass="form-field" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label prefWidth="80.0" text="Contraseña:" />
